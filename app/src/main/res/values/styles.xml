<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="EtiquetaCampo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/dorado</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CampoRegistro">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/login_campo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/crema</item>
        <item name="android:textColorHint">#88F5EAD6</item>
        <item name="android:textSize">15sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="TarjetaGaleria">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="FotoGaleria">
        <item name="android:layout_width">132dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:background">@drawable/login_campo</item>
        <item name="android:contentDescription">@string/galeria_titulo</item>
        <item name="android:padding">3dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="PieGaleria">
        <item name="android:layout_width">132dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/crema</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BotonMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/login_boton</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/verde_profundo</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotonMenuSec">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/login_boton_secundario</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/crema</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>