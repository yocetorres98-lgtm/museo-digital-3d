<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizRegistro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_profundo"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ PORTADA CON FOTO ============ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp">

            <ImageView
                android:id="@+id/portadaRegistro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.55"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/galeria_banner" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/registro_degradado" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="20dp"
                android:paddingEnd="26dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.35"
                    android:text="@string/museo_digital_3d"
                    android:textColor="@color/dorado"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="@string/ruta_municipios"
                    android:textColor="@color/crema"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.9"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="@string/registro_subtitulo"
                    android:textColor="@color/crema"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ============ FORMULARIO ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <!-- Selector Registrarse / Entrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pestanaRegistro"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_pestana_activa"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:onClick="onPestanaRegistro"
                    android:text="@string/tab_registro"
                    android:textColor="@color/crema"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pestanaLogin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_pestana_inactiva"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:onClick="onPestanaLogin"
                    android:text="@string/tab_login"
                    android:textColor="@color/crema"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Campo: nombre -->
            <TextView
                android:id="@+id/etiquetaNombre"
                style="@style/EtiquetaCampo"
                android:text="@string/campo_nombre" />

            <EditText
                android:id="@+id/campoNombre"
                style="@style/CampoRegistro"
                android:hint="@string/hint_nombre"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="30" />

            <!-- Campo: correo -->
            <TextView
                android:id="@+id/etiquetaCorreo"
                style="@style/EtiquetaCampo"
                android:text="@string/campo_correo" />

            <EditText
                android:id="@+id/campoCorreo"
                style="@style/CampoRegistro"
                android:hint="@string/hint_correo"
                android:inputType="textEmailAddress"
                android:maxLength="60" />

            <!-- Campo: contraseña -->
            <TextView
                android:id="@+id/etiquetaClave"
                style="@style/EtiquetaCampo"
                android:text="@string/campo_password" />

            <EditText
                android:id="@+id/campoClave"
                style="@style/CampoRegistro"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:maxLength="24" />

            <!-- Confirmar contraseña (solo al registrarse) -->
            <TextView
                android:id="@+id/etiquetaRepetir"
                style="@style/EtiquetaCampo"
                android:text="@string/campo_repetir" />

            <EditText
                android:id="@+id/campoRepetir"
                style="@style/CampoRegistro"
                android:hint="@string/hint_repetir"
                android:inputType="textPassword"
                android:maxLength="24" />

            <TextView
                android:id="@+id/avisoRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/login_error"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/crema"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Acción principal -->
            <TextView
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/login_boton"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:onClick="onEnviar"
                android:text="@string/btn_registrarme"
                android:textColor="@color/verde_profundo"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Invitado -->
            <TextView
                android:id="@+id/btnInvitado"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/login_boton_secundario"
                android:gravity="center"
                android:onClick="onInvitado"
                android:text="@string/btn_invitado"
                android:textColor="@color/crema"
                android:textSize="14sp" />

            <!-- ============ GALERÍA DE IMÁGENES ============ -->
            <TextView
                style="@style/EtiquetaCampo"
                android:layout_marginTop="26dp"
                android:text="@string/galeria_titulo" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/TarjetaGaleria">

                        <ImageView style="@style/FotoGaleria" android:src="@drawable/galeria_1" />

                        <TextView style="@style/PieGaleria" android:text="@string/mun_amecameca" />
                    </LinearLayout>

                    <LinearLayout style="@style/TarjetaGaleria">

                        <ImageView style="@style/FotoGaleria" android:src="@drawable/galeria_2" />

                        <TextView style="@style/PieGaleria" android:text="@string/mun_chalco" />
                    </LinearLayout>

                    <LinearLayout style="@style/TarjetaGaleria">

                        <ImageView style="@style/FotoGaleria" android:src="@drawable/galeria_3" />

                        <TextView style="@style/PieGaleria" android:text="@string/mun_ozumba" />
                    </LinearLayout>

                    <LinearLayout style="@style/TarjetaGaleria">

                        <ImageView style="@style/FotoGaleria" android:src="@drawable/galeria_4" />

                        <TextView style="@style/PieGaleria" android:text="@string/mun_ayapango" />
                    </LinearLayout>

                    <LinearLayout style="@style/TarjetaGaleria">

                        <ImageView style="@style/FotoGaleria" android:src="@drawable/galeria_5" />

                        <TextView style="@style/PieGaleria" android:text="@string/mun_nepantla" />
                    </LinearLayout>

                    <LinearLayout style="@style/TarjetaGaleria">

                        <ImageView style="@style/FotoGaleria" android:src="@drawable/galeria_6" />

                        <TextView style="@style/PieGaleria" android:text="@string/mun_ecatzingo" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/galeria_pie"
                android:textColor="@color/crema"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>