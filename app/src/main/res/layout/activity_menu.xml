<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_profundo"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ PORTADA ============ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/galeria_banner" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/registro_degradado" />

            <TextView
                android:id="@+id/textoMenuSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/hud_button"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="@string/menu_chip_sin"
                android:textColor="@color/crema"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="20dp"
                android:paddingEnd="26dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.35"
                    android:text="@string/museo_digital_3d"
                    android:textColor="@color/dorado"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="@string/menu_titulo"
                    android:textColor="@color/crema"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.9"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="@string/menu_subtitulo"
                    android:textColor="@color/crema"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ============ OPCIONES ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/BotonMenu"
                android:layout_marginTop="0dp"
                android:onClick="onLogin"
                android:text="@string/menu_btn_login" />

            <TextView
                style="@style/BotonMenu"
                android:onClick="onAdmin"
                android:text="@string/menu_btn_admin" />

            <TextView
                style="@style/BotonMenuSec"
                android:onClick="onMapa"
                android:text="@string/menu_btn_mapa" />

            <TextView
                style="@style/BotonMenuSec"
                android:onClick="onRecorrido"
                android:text="@string/menu_btn_recorrido" />

            <TextView
                android:id="@+id/menuCerrarSesion"
                style="@style/BotonMenuSec"
                android:onClick="onCerrarSesion"
                android:text="@string/menu_btn_cerrar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.6"
                android:gravity="center"
                android:text="@string/menu_pie"
                android:textColor="@color/crema"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>