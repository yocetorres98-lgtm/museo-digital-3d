<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_profundo"
    android:keepScreenOn="true">

    <!-- ============ MUNDO 3D ============ -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ============ HUD DE JUEGO ============ -->
    <FrameLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- ===== Zona superior: objetivo + progreso + botones (vertical) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <!-- Objetivo actual -->
                <LinearLayout
                    android:id="@+id/panelObjetivo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/hud_panel"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="11dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.2"
                        android:text="@string/hud_objetivo"
                        android:textColor="@color/dorado"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/textoObjetivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Habla con la guía"
                        android:textColor="@color/crema"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textoPista"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.85"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Acércate y pulsa VER"
                        android:textColor="@color/crema"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Botones superiores -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPasillo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/hud_button"
                        android:gravity="center"
                        android:onClick="onPasillo"
                        android:text="🚪"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/btnMapa"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/hud_button"
                        android:gravity="center"
                        android:onClick="onMapa"
                        android:text="🗺"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/btnInfo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/hud_button"
                        android:gravity="center"
                        android:onClick="onInfo"
                        android:text="@string/btn_info"
                        android:textColor="@color/crema"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Progreso -->
            <LinearLayout
                android:id="@+id/panelProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/hud_panel"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/textoProgreso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="Progreso 0/12"
                    android:textColor="@color/crema"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/barraProgreso"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/hud_progress_bg" />
            </LinearLayout>
        </LinearLayout>

        <!-- Joystick virtual -->
        <com.museo.guia.JoystickView
            android:id="@+id/joystick"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="18dp" />

        <!-- Botón de interacción -->
        <TextView
            android:id="@+id/btnAccion"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/hud_button"
            android:gravity="center"
            android:onClick="onAccion"
            android:text="VER"
            android:textColor="@color/crema"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Brújula / dirección -->
        <TextView
            android:id="@+id/brujula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:alpha="0.8"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.3"
            android:text="◀  ·  ·  ▶"
            android:textColor="@color/crema"
            android:textSize="12sp" />

        <!-- Aviso central -->
        <TextView
            android:id="@+id/aviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"
            android:layout_marginBottom="150dp"
            android:background="@drawable/hud_panel"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:text=""
            android:textColor="@color/crema"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============ PANTALLA DE INICIO ============ -->
    <ScrollView
        android:id="@+id/portada"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/verde_profundo"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="48dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:alpha="0.75"
                android:background="@drawable/hud_panel"
                android:contentDescription="@string/app_name"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/galeria_banner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.35"
                android:text="@string/museo_digital_3d"
                android:textColor="@color/dorado"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/ruta_municipios"
                android:textColor="@color/crema"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoSaludo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alpha="0.9"
                android:gravity="center"
                android:text="@string/invitado"
                android:textColor="@color/crema"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.8"
                android:gravity="center"
                android:text="@string/registro_subtitulo"
                android:textColor="@color/crema"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnComenzar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/hud_progress_bg"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:onClick="onComenzar"
                android:text="@string/btn_comenzar"
                android:textColor="@color/verde_profundo"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoCargando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alpha="0.7"
                android:text="@string/loading"
                android:textColor="@color/crema"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>