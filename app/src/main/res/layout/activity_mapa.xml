<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_profundo"
    android:orientation="vertical">

    <!-- ============ BARRA SUPERIOR ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.3"
                android:text="@string/mapa_titulo"
                android:textColor="@color/dorado"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:alpha="0.85"
                android:text="@string/mapa_subtitulo"
                android:textColor="@color/crema"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCerrarMapa"
            android:layout_width="74dp"
            android:layout_height="36dp"
            android:background="@drawable/mapa_chip"
            android:gravity="center"
            android:onClick="onCerrarMapa"
            android:text="@string/mapa_cerrar"
            android:textColor="@color/crema"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ============ CONTENIDO ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <!-- Mapa de la región con pines encima -->
            <FrameLayout
                android:id="@+id/mapaZona"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/mapa_marco"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/mapaRegion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/mapa_titulo"
                    android:scaleType="fitXY"
                    android:src="@drawable/mapa_region" />
            </FrameLayout>

            <TextView
                android:id="@+id/textoArrastra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:alpha="0.85"
                android:gravity="center"
                android:text="@string/mapa_arrastra"
                android:textColor="@color/crema"
                android:textSize="12sp" />

            <!-- Avance -->
            <TextView
                android:id="@+id/textoAvanceMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/mapa_chip"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="11dp"
                android:paddingEnd="16dp"
                android:paddingBottom="11dp"
                android:text="@string/mapa_avance_0"
                android:textColor="@color/crema"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="@string/mapa_ruta"
                android:textColor="@color/dorado"
                android:textSize="11sp" />

            <!-- Filas de tarjetas (se generan en MapaActivity) -->
            <LinearLayout
                android:id="@+id/contenedorSalas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/mapa_pie"
                android:textColor="@color/crema"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ============ ACCIÓN INFERIOR ============ -->
    <TextView
        android:id="@+id/btnIniciarRecorrido"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/login_boton"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:onClick="onIniciarRecorrido"
        android:text="@string/btn_iniciar_recorrido"
        android:textColor="@color/verde_profundo"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>