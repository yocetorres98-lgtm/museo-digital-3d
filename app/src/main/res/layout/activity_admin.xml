<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_profundo">

    <!-- ============ INICIO DE SESIÓN ADMIN ============ -->
    <ScrollView
        android:id="@+id/loginAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="52dp"
            android:paddingEnd="26dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.35"
                android:text="@string/museo_digital_3d"
                android:textColor="@color/dorado"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/admin_titulo"
                android:textColor="@color/crema"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoAdminSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.85"
                android:text="@string/admin_subtitulo"
                android:textColor="@color/crema"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/etiquetaAdminNombre"
                style="@style/EtiquetaCampo"
                android:text="@string/admin_nombre" />

            <EditText
                android:id="@+id/campoAdminNombre"
                style="@style/CampoRegistro"
                android:hint="@string/admin_hint_nombre"
                android:inputType="textPersonName"
                android:maxLength="60" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="@string/admin_correo" />

            <EditText
                android:id="@+id/campoAdminCorreo"
                style="@style/CampoRegistro"
                android:hint="@string/admin_hint_correo"
                android:inputType="textEmailAddress"
                android:maxLength="80" />

            <TextView
                style="@style/EtiquetaCampo"
                android:text="@string/admin_clave" />

            <EditText
                android:id="@+id/campoAdminClave"
                style="@style/CampoRegistro"
                android:hint="@string/admin_hint_clave"
                android:inputType="textPassword"
                android:maxLength="64" />

            <TextView
                android:id="@+id/etiquetaAdminRepetir"
                style="@style/EtiquetaCampo"
                android:text="@string/admin_repetir"
                android:visibility="gone" />

            <EditText
                android:id="@+id/campoAdminRepetir"
                style="@style/CampoRegistro"
                android:hint="@string/admin_hint_repetir"
                android:inputType="textPassword"
                android:maxLength="64"
                android:visibility="gone" />

            <TextView
                android:id="@+id/avisoAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/login_error"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/crema"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/botonAdminPrincipal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/login_boton"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:onClick="onEntrarAdmin"
                android:text="@string/admin_entrar"
                android:textColor="@color/verde_profundo"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/login_boton_secundario"
                android:gravity="center"
                android:onClick="onVolver"
                android:text="@string/admin_volver"
                android:textColor="@color/crema"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ============ PANEL DE ADMINISTRACIÓN ============ -->
    <LinearLayout
        android:id="@+id/panelAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="44dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="@string/museo_digital_3d"
            android:textColor="@color/dorado"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/admin_panel_titulo"
            android:textColor="@color/crema"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adminCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/dorado"
            android:textSize="13sp" />

        <!-- Tarjeta: total de ingresos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/login_campo"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="@string/admin_ingresos"
                android:textColor="@color/dorado"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/adminTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="@color/crema"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adminHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_hoy"
                android:textColor="@color/verde_acento"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/login_boton_secundario"
                android:gravity="center"
                android:onClick="onReiniciarContador"
                android:text="@string/admin_reiniciar"
                android:textColor="@color/crema"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/login_boton_secundario"
                android:gravity="center"
                android:onClick="onSalirAdmin"
                android:text="@string/admin_salir"
                android:textColor="@color/crema"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/login_boton_secundario"
            android:gravity="center"
            android:onClick="onBorrarCuenta"
            android:text="@string/admin_borrar_boton"
            android:textColor="@color/rojo_suave"
            android:textSize="12sp" />

        <TextView
            style="@style/EtiquetaCampo"
            android:layout_marginTop="18dp"
            android:text="@string/admin_usuarios_titulo" />

        <TextView
            android:id="@+id/adminUsuariosEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/admin_usuarios_cargando"
            android:textColor="@color/dorado"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/login_campo"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/adminUsuariosLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/admin_usuarios_cargando"
                    android:textColor="@color/crema"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#33FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/admin_registro"
                    android:textColor="@color/dorado"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/adminLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/admin_sin_registros"
                    android:textColor="@color/crema"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/login_boton_secundario"
            android:gravity="center"
            android:onClick="onVolver"
            android:text="@string/admin_volver"
            android:textColor="@color/crema"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>